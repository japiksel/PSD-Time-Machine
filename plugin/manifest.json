{
  "id": "com.timemachine.psd",
  "name": "PSD Time Machine",
  "version": "1.0.0",
  "host": [
    {
      "app": "PS",
      "minVersion": "23.0.0"
    }
  ],
  "manifestVersion": 5,
  "entrypoints": [
    {
      "type": "panel",
      "id": "psdTimeMachinePanel",
      "label": {
        "default": "PSD Time Machine"
      },
      "minimumSize": {
        "width": 320,
        "height": 400
      },
      "maximumSize": {
        "width": 1200,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 400,
        "height": 650
      },
      "icons": []
    }
  ],
  "requiredPermissions": [
    {
      "requiredPermissions": [
        "localFileSystem",
        "launchProcess",
        "allowCodeGenerationFromStrings",
        "ipc",
        "webview",
        "clipboard"
      ]
    }
  ]
}
